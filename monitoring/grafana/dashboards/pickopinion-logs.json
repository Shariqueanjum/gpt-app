{
 "uid": "pickopinion-logs",
 "title": "PickOpinion - Logs overview",
 "tags": [
  "pickopinion"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Requests (last 1h)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({job=\"gpt-app\", event=\"http_request\"}[1h]))",
     "queryType": "instant"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Errors (last 1h)",
   "datasource": {
    "type": "loki",
