  {
   "id": 5,
   "type": "timeseries",
   "title": "Requests per minute",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({job=\"gpt-app\", event=\"http_request\"}[1m]))",
     "legendFormat": "requests"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     },
     "noValue": "0"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Log lines by level",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (level) (count_over_time({job=\"gpt-app\", level!=\"\"}[$__auto]))",
     "legendFormat": "{{level}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      }
     },
     "noValue": "0"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
