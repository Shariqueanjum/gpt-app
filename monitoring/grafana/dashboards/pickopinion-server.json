  {
   "id": 14,
   "type": "bargauge",
   "title": "Container memory vs its limit (only containers with a limit)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
