    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * container_memory_working_set_bytes{name!=\"\"} / on(name) (container_spec_memory_limit_bytes{name!=\"\"} > 0)",
